<Application x:Class="Ampero.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ampero.Gui"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#16181D" />
        <SolidColorBrush x:Key="Panel" Color="#21242B" />
        <SolidColorBrush x:Key="PanelAlt" Color="#262A32" />
        <SolidColorBrush x:Key="Fg" Color="#ECEEF2" />
        <SolidColorBrush x:Key="Muted" Color="#9AA1AD" />
        <SolidColorBrush x:Key="Accent" Color="#F5A524" />

        <local:NotConverter x:Key="Not" />

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#111" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SceneButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Panel}" BorderBrush="#3A3F49" BorderThickness="2"
                                CornerRadius="8" Padding="16,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Muted}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="#111" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
