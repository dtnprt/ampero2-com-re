<Window x:Class="Ampero.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ampero II Remote" Height="780" Width="1280" MinWidth="980" MinHeight="600"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" FontFamily="Segoe UI" FontSize="14">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{StaticResource Panel}" Foreground="{StaticResource Fg}">
            <MenuItem Header="_Datei">
                <MenuItem Header="Preset-Datei öffnen…" Command="{Binding OpenFileCommand}" Foreground="Black" />
                <MenuItem Header="Preset speichern unter…" Command="{Binding SaveFileCommand}" Foreground="Black" />
                <Separator />
                <MenuItem Header="Algorithmus-DB laden…" Command="{Binding LoadAlgDbCommand}" Foreground="Black" />
            </MenuItem>
        </Menu>

        <!-- connection bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="MIDI In" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="200" ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}"
                          IsEnabled="{Binding IsConnected, Converter={StaticResource Not}}" />
                <TextBlock Text="MIDI Out" VerticalAlignment="Center" Margin="14,0,6,0" />
                <ComboBox Width="200" ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}"
                          IsEnabled="{Binding IsConnected, Converter={StaticResource Not}}" />
                <Button Content="↻" Width="32" Margin="8,0,0,0" Command="{Binding RefreshPortsCommand}" ToolTip="Ports neu einlesen" />
                <Button Content="{Binding ConnectLabel}" Width="110" Margin="8,0,0,0" Command="{Binding ConnectCommand}" Style="{StaticResource AccentButton}" />
                <CheckBox Content="Gerät abfragen (1 s)" IsChecked="{Binding PollDevice}" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Fg}" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="{StaticResource Muted}" />
                <TextBlock Text="{Binding Firmware, StringFormat=Firmware {0}}" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource Muted}" />
            </StackPanel>
        </Border>

        <!-- log -->
        <Expander DockPanel.Dock="Bottom" Header="Protokoll" Foreground="{StaticResource Fg}" Margin="10,0,10,8">
            <DockPanel Height="170">
                <Button DockPanel.Dock="Right" Content="Leeren" VerticalAlignment="Top" Margin="6,0,0,0" Command="{Binding ClearLogCommand}" />
                <ListBox x:Name="LogList" ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="12"
                         Background="{StaticResource Panel}" Foreground="{StaticResource Fg}" BorderThickness="0" />
            </DockPanel>
        </Expander>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="230" />
            </Grid.ColumnDefinitions>

            <!-- preset list -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock DockPanel.Dock="Top" Text="PRESETS" Style="{StaticResource Caption}" />
                <TextBox DockPanel.Dock="Top" Text="{Binding PresetFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,6"
                         ToolTip="Filter nach Name oder Nummer" />
                <Button DockPanel.Dock="Bottom" Content="Auf dem Gerät wählen" Margin="0,6,0,0" Command="{Binding LoadSelectedPresetCommand}" />
                <ListBox ItemsSource="{Binding FilteredPresets}" SelectedItem="{Binding SelectedPreset}"
                         MouseDoubleClick="PresetList_DoubleClick" Background="{StaticResource Panel}" Foreground="{StaticResource Fg}"
                         BorderThickness="0" FontFamily="Consolas" />
            </DockPanel>

            <!-- current preset -->
            <DockPanel Grid.Column="1">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PresetNumber}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding PresetStyle}" Style="{StaticResource Caption}" Margin="16,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding PresetName}" FontSize="46" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Scenes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Index}" Style="{StaticResource SceneButton}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="13" Opacity="0.75" />
                                        <TextBlock Text="{Binding Name}" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Details}" FontSize="12" Opacity="0.75" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="EFFEKTE DER AKTIVEN SZENE" Style="{StaticResource Caption}" Margin="0,16,0,4" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Slots}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="None" Background="{StaticResource Panel}" RowBackground="{StaticResource Panel}"
                          AlternatingRowBackground="{StaticResource PanelAlt}" Foreground="{StaticResource Fg}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="45" />
                        <DataGridCheckBoxColumn Header="An" Binding="{Binding Enabled}" Width="40" />
                        <DataGridTextColumn Header="Modul" Binding="{Binding Module}" Width="80" />
                        <DataGridTextColumn Header="Effekt" Binding="{Binding Effect}" Width="160" />
                        <DataGridTextColumn Header="Parameter" Binding="{Binding Parameters}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- side panel -->
            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                <TextBlock Text="FOOTSWITCHES" Style="{StaticResource Caption}" />
                <ItemsControl ItemsSource="{Binding Footswitches}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Panel}" Margin="0,0,0,6" Padding="10,6" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Footswitch}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Function, StringFormat=Funktion {0}}" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Preset neu laden" Margin="0,12,0,0" Command="{Binding ReloadCommand}" />
                <TextBlock TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{StaticResource Muted}" FontSize="12"
                           Text="Hinweis: Der Hotone-Editor muss geschlossen sein – Windows-MIDI-Ports lassen sich nur von einem Programm öffnen." />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
